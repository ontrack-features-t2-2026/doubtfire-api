<% content_for :preheader do %>Verify the additional email address requested in <%= @product_name %>.<% end %>
<% content_for :heading do %>Verify your additional email<% end %>

<p style="margin:0 0 16px 0;">Hello <%= @user.nickname.presence || @user.first_name %>,</p>

<p style="margin:0 0 16px 0;">
  Use the link below to verify that you own the additional email address requested in
  <%= @product_name %>.
</p>

<%= render 'layouts/notification_mail/button', url: @verification_url, label: 'Verify additional notification email' %>

<% content_for :footer do %>
  <p style="margin:0;">
    The link expires after 24 hours. If you did not request this, you can ignore this message.
    No notification copies are sent to this address until verification succeeds.
  </p>
<% end %>
