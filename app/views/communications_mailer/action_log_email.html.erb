<% content_for :preheader do %><%= @affected_students_count %> students matched this rule.<% end %>
<% content_for :heading do %><%= @doubtfire_product_name %> Notification<% end %>

<p style="margin:0 0 16px 0;">Hi <%= @recipient&.nickname.presence || @recipient&.first_name || @recipient&.name %>,</p>

<% @body_paragraphs.each do |paragraph| %>
  <p style="margin:0 0 16px 0;"><%= paragraph %></p>
<% end %>

<% affected_summary = capture do %>
  <strong style="font-size:20px;"><%= @affected_students_count %></strong>
  students matched this rule and were affected by the configured actions.
<% end %>
<%= render 'layouts/notification_mail/details', body: affected_summary %>

<p style="margin:0 0 16px 0;">A full log of actions has been attached as a CSV.</p>

<p style="margin:24px 0 0 0;">
  Cheers,<br />
  The <%= @doubtfire_product_name %> Team
</p>
