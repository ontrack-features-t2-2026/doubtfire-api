<% content_for :icon do %>summary<% end %>
<% week_range = "#{@summary_stats[:week_start].day.ordinalize} #{@summary_stats[:week_start].strftime("%B %Y")} to #{@summary_stats[:week_end].day.ordinalize} #{@summary_stats[:week_end].strftime("%B %Y")}" %>
<% content_for :preheader do %><%= week_range %><% end %>
<% content_for :heading do %><%= @summary_stats[:unit].name %> - Weekly Summary<% end %>
<% content_for :subheading do %><%= week_range %><% end %>

<p style="margin:0 0 20px 0;">Hi <%= @student.first_name %>,</p>

<% if @did_revert_to_pass %>
  <% revert_note = capture do %>
    <p style="margin:0 0 8px 0;">Your target grade has been reset to Pass while you catch up.</p>
    <p style="margin:0;">Every Pass task has to be marked Complete to pass this unit, so work through them in order. Once you have caught up you can set your target grade back and return to the higher grade tasks you skipped.</p>
  <% end %>
  <%= render 'layouts/notification_mail/details', body: revert_note, category: 'due', label: 'Falling behind on pass tasks' %>
<% end %>

<% if @project.tutorial_enrolments.blank? %>
  <% no_tutor = capture do %>
    You are not assigned a tutor. Set your tutorial on your
    <a href="<%= @doubtfire_host%>/projects/<%= @project.id%>/tutorials" class="ot-link" style="color:#b42318; text-decoration:underline;">tutorials page</a>
    so your work reaches someone.
  <% end %>
  <%= render 'layouts/notification_mail/details', body: no_tutor, category: 'alert', label: 'No tutor set' %>
<% end %>

<%# Lead with what is actually due, not with the week that has already gone. %>
<% if @overdue_top && @overdue_top.count > 0 %>
  <% focus = capture do %>
    <strong style="font-size:20px;"><%= @overdue_top.count %></strong>
    task<%= "s" if @overdue_top.count > 1 %> <%= @overdue_top.count == 1 ? 'is' : 'are' %> overdue. Start there.
  <% end %>
  <%= render 'layouts/notification_mail/details', body: focus, category: 'due', label: 'Focus on this' %>
<% elsif @soon_top && @soon_top.count > 0 %>
  <% focus = capture do %>
    <strong style="font-size:20px;"><%= @soon_top.count %></strong>
    task<%= "s" if @soon_top.count > 1 %> <%= @soon_top.count == 1 ? 'is' : 'are' %> due soon. Nothing is overdue.
  <% end %>
  <%= render 'layouts/notification_mail/details', body: focus, category: 'summary', label: 'Focus on this' %>
<% elsif @top_tasks.blank? && @project.portfolio_exists? %>
  <%= render 'layouts/notification_mail/details', body: 'Every task is done and your portfolio is prepared. Time to party.', category: 'submission', label: 'All caught up' %>
<% elsif @top_tasks.blank? %>
  <%= render 'layouts/notification_mail/details', body: 'Every task is done. Log in and prepare your portfolio to finish up.', category: 'submission', label: 'Almost there' %>
<% end %>

<% task_groups = [
     ['Overdue', @overdue_top],
     ['Due soon', @soon_top],
     ['Get ahead', @ahead_top]
   ] %>
<% task_groups.each do |group_label, group_tasks| %>
  <% next if group_tasks.blank? %>
  <p style="margin:0 0 12px 0; font-size:14px; font-weight:600; letter-spacing:0.4px; text-transform:uppercase; color:#6b7280;"><%= group_label %></p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 20px 0; border-collapse:collapse;">
    <% group_tasks.each_with_index do |tt, index| %>
      <% definition = tt[:task_definition] %>
      <tr>
        <td valign="top" width="96" style="width:96px; padding:<%= index.zero? ? '0' : '12px' %> 14px 12px 0; border-bottom:1px solid #e5e7eb;">
          <span style="display:inline-block; padding:3px 9px; border:1px solid #e5e7eb; border-radius:4px; background-color:#f9fafb; font-size:13px; line-height:1.3; font-weight:700; color:#374151;"><%= definition.abbreviation %></span>
        </td>
        <td valign="top" style="padding:<%= index.zero? ? '0' : '12px' %> 0 12px 0; border-bottom:1px solid #e5e7eb; font-size:15px; line-height:1.5;">
          <a href="<%= @doubtfire_host %>/projects/<%= @project.id %>/dashboard/<%= ERB::Util.url_encode(definition.abbreviation) %>" class="ot-link" style="color:#3939ff; text-decoration:underline;"><%= definition.name %></a>
          <% if tt[:status] == :discuss %>
            <span class="ot-muted" style="color:#6b7280;">- discuss this one with your tutor</span>
          <% end %>
        </td>
      </tr>
    <% end %>
  </table>
<% end %>

<%= render 'layouts/notification_mail/button', url: "#{@doubtfire_host}/projects/#{@project.id}/dashboard", label: "Open your unit in #{@doubtfire_product_name}" %>

<p style="margin:0 0 12px 0; font-size:14px; font-weight:600; letter-spacing:0.4px; text-transform:uppercase; color:#6b7280;">Your week</p>
<%= render 'layouts/notification_mail/stats', rows: [
      [@sent_comments, "comment#{'s' if @sent_comments != 1} you posted#{@sent_comments == 0 ? ' - try posting some this week' : ''}"],
      [@received_comments, "comment#{'s' if @received_comments != 1} you received"],
      [@engagements_count, "change#{'s' unless @engagements_count == 1} to your tasks#{@student_engagements == 0 ? ' - looks like you need to be more active' : ''}"],
      [@summary_stats[:unit_week_comments], "comment#{'s' if @summary_stats[:unit_week_comments] != 1} made across the unit"],
      [@summary_stats[:unit_week_engagements], "task state change#{'s' unless @summary_stats[:unit_week_engagements] == 1} across the unit"]
    ] %>

<p style="margin:24px 0 0 0;">
    Cheers, <br />
    The <%= @doubtfire_product_name %> Team on behalf of <%= @tutor.name %>
</p>

<% content_for :footer do %>
  <p style="margin:0;">
    <a href="<%= @unsubscribe_url %>" style="color:#6b7280; text-decoration:underline;">Unsubscribe</a> | Generated with <%= @doubtfire_product_name %>
  </p>
<% end %>
