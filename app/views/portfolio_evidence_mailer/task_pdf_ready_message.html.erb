<% content_for :preheader do %>Your submitted evidence is ready to be viewed and assessed.<% end %>
<% content_for :heading do %>Task PDFs ready to view<% end %>

<p style="margin:0 0 16px 0;">Hi <%= @student.first_name %>,</p>
<p style="margin:0 0 8px 0;">
  The following evidence you submitted to <%= @doubtfire_product_name %> is now prepared and ready to be viewed and assessed by your tutor:
</p>
<ul style="margin:0 0 16px 0; padding:0 0 0 20px;">
  <% @tasks.each do |task| %>
    <li style="margin:0 0 8px 0;">
      <strong><%= task.task_definition.abbreviation %> - </strong>
      <a href="<%= @doubtfire_host %>/projects/<%= @project.id %>/dashboard/<%= ERB::Util.url_encode(task.task_definition.abbreviation) %>" class="ot-link" style="color:#3939ff; text-decoration:underline;"><%= task.task_definition.name %></a>
    </li>
  <% end %>
</ul>

<p style="margin:24px 0 0 0;">
  Cheers, <br />
  The <%= @doubtfire_product_name %> Team on behalf of <%= @tutor.name %>
</p>

<% content_for :footer do %>
  <p style="margin:0;">
    <a href="<%= @unsubscribe_url %>" style="color:#6b7280; text-decoration:underline;">Unsubscribe</a> | Generated with <%= @doubtfire_product_name %>
  </p>
<% end %>
