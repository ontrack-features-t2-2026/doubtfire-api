<%# A week of numbers as rows, the figure first. The summary emails used to put
    these in a bulleted list where every line began with words, so the numbers
    were buried mid sentence and nothing could be found without reading all of
    them. Takes an array of [value, label] pairs. %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 20px 0; border-collapse:collapse; border:1px solid #e5e7eb; border-radius:6px;">
  <% rows.each_with_index do |(value, label), index| %>
    <tr>
      <td align="right" valign="top" width="64" style="width:64px; padding:10px 14px 10px 16px; <%= 'border-top:1px solid #e5e7eb;' unless index.zero? %> font-size:18px; line-height:1.3; font-weight:700; color:#111827;"><%= value %></td>
      <td valign="top" style="padding:12px 16px 10px 0; <%= 'border-top:1px solid #e5e7eb;' unless index.zero? %> font-size:14px; line-height:1.4; color:#4b5563;"><%= label %></td>
    </tr>
  <% end %>
</table>
