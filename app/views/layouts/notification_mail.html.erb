<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="x-apple-disable-message-reformatting">
  <meta name="color-scheme" content="light dark">
  <meta name="supported-color-schemes" content="light dark">
  <title><%= message.subject %></title>
  <style type="text/css">
    @media (prefers-color-scheme: dark) {
      .ot-bg { background-color: #111318 !important; }
      .ot-card { background-color: #1b1e25 !important; border-color: #2a2e37 !important; }
      .ot-text, .ot-text p, .ot-text li, .ot-text td, .ot-text th { color: #e5e7eb !important; }
      .ot-muted, .ot-muted a { color: #9ca3af !important; }
      .ot-details { background-color: #232733 !important; border-color: #6b6bff !important; }
      .ot-wordmark { color: #8a8aff !important; }
      .ot-link { color: #8a8aff !important; }
    }
    @media only screen and (max-width: 620px) {
      .ot-pad { padding-left: 20px !important; padding-right: 20px !important; }
    }
  </style>
</head>
<% product_name = @doubtfire_product_name.presence || @product_name.presence || 'OnTrack' %>
<body class="ot-bg" style="margin:0; padding:0; width:100%; background-color:#f3f4f6; -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%;">
  <% if content_for?(:preheader) %>
    <div style="display:none; max-height:0; overflow:hidden; mso-hide:all; font-size:1px; line-height:1px; color:#f3f4f6; opacity:0;">
      <%= yield :preheader %>&#8203;&nbsp;&#8203;&nbsp;&#8203;&nbsp;&#8203;&nbsp;&#8203;&nbsp;&#8203;&nbsp;
    </div>
  <% end %>
  <table role="presentation" class="ot-bg" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f3f4f6;">
    <tr>
      <td align="center" style="padding:32px 12px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; width:100%;">
          <tr>
            <td class="ot-pad" style="padding:0 8px 16px 8px; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif, system-ui;">
              <span class="ot-wordmark" style="font-size:22px; font-weight:700; letter-spacing:-0.3px; color:#3939ff;"><%= product_name %></span>
            </td>
          </tr>
          <tr>
            <td class="ot-card ot-text ot-pad" style="background-color:#ffffff; border:1px solid #e5e7eb; border-radius:8px; padding:32px 40px; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif, system-ui; font-size:16px; line-height:1.5; color:#1f2937; text-align:left;">
              <% if content_for?(:heading) %>
                <h1 style="margin:0 0 16px 0; font-size:22px; line-height:1.3; font-weight:700; color:#111827;" class="ot-text"><%= yield :heading %></h1>
              <% end %>
              <%= yield %>
            </td>
          </tr>
          <tr>
            <td class="ot-muted ot-pad" align="center" style="padding:20px 24px 0 24px; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif, system-ui; font-size:13px; line-height:1.5; color:#6b7280;">
              <% if content_for?(:footer) %>
                <%= yield :footer %>
              <% end %>
              <p style="margin:8px 0 0 0; color:#9ca3af;">Sent by <%= product_name %></p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
